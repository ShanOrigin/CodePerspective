# CodePerspective — Email Configuration
# Copy this file to .env and fill in your SMTP credentials.
# The .env file is gitignored and must NEVER be committed.
#
# ──────────────────────────────────────────
# SMTP Provider Examples
# ──────────────────────────────────────────
#
# Gmail (use an App Password, not your login password):
#   MAIL_HOST=smtp.gmail.com
#   MAIL_PORT=587
#   MAIL_SECURE=false
#   MAIL_USER=your-gmail@gmail.com
#   MAIL_PASS=your-app-password
#
# Outlook / Hotmail:
#   MAIL_HOST=smtp-mail.outlook.com
#   MAIL_PORT=587
#   MAIL_SECURE=false
#
# SendGrid:
#   MAIL_HOST=smtp.sendgrid.net
#   MAIL_PORT=587
#   MAIL_SECURE=false
#   MAIL_USER=apikey
#   MAIL_PASS=<your-sendgrid-api-key>
#
# Brevo (Sendinblue):
#   MAIL_HOST=smtp-relay.brevo.com
#   MAIL_PORT=587
#   MAIL_SECURE=false
#
# ──────────────────────────────────────────

# SMTP server hostname
MAIL_HOST=smtp.gmail.com

# SMTP port (587 for STARTTLS, 465 for SSL)
MAIL_PORT=587

# Use SSL? Set to true only with port 465
MAIL_SECURE=false

# SMTP login username (usually your email address)
MAIL_USER=your-email@gmail.com

# SMTP password or App Password
MAIL_PASS=your-app-password-here

# Where to deliver form submissions (defaults to MAIL_USER if not set)
MAIL_TO=shantanusuryawanshi3.14@gmail.com
