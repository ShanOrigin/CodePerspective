fn binary_search(arr: &[i32], key: i32) -> Option<usize> {
    let mut low = 0;
    let mut high = arr.len() - 1;
    
    while low <= high {
        let mid = low + (high - low) / 2;
        
        if arr[mid] == key {
            return Some(mid);  // Return index if key is found
        }
        else if arr[mid] < key {
            low = mid + 1;  // If key is greater, search in the right half
        }
        else {
            high = mid - 1;  // If key is smaller, search in the left half
        }
    }
    
    None  // Return None if key is not found
}

fn main() {
    let arr = [1, 2, 4, 5, 8, 9];
    let key = 8;

    match binary_search(&arr, key) {
        Some(index) => println!("Element found at index {}", index),
        None => println!("Element not found"),
    }
}
